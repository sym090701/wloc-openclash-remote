# Copy to config.env and replace the example LAN values.
WLOC_ALLOWED_CLIENTS=192.168.50.1
WLOC_INITIAL_DEVICE_IP=192.168.50.1
WLOC_INITIAL_DEVICE_NAME=All-LAN-Devices
WLOC_INITIAL_DEVICE_MAC=
WLOC_INITIAL_LOCATION_NAME=Initial-Location
WLOC_LATITUDE=39.90872
WLOC_LONGITUDE=116.39748
WLOC_ACCURACY=39
WLOC_WEBUI_BIND=192.168.50.2
WLOC_WEBUI_PORT=18082
WLOC_WEBUI_ALLOWED_NETWORKS=192.168.50.0/24
WLOC_WEBUI_ALLOWED_HOSTS=192.168.50.2:18082
# The router-side hook owns the static global routing rule.
WLOC_STATIC_OPENCLASH_RULES=1
WLOC_MIHOMO_API=http://127.0.0.1:9
WLOC_PROVIDER_PATH=/opt/wloc-rules/wloc-clients.yaml
